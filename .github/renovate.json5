{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  // Rebase whenever main moves so PR checks always run against the current workflow and Containerfile
  "rebaseWhen": "behind-base-branch",

  // Bumps versions annotated with `# renovate: datasource=... depName=...` in build scripts.
  // Downloads are verified against upstream-signed checksums at build time, so no hashes need bumping.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/.+\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+=(?<currentValue>\\S+)",
      ],
    },
    {
      // Same annotation for tool versions passed as action inputs, e.g. sbom-action's syft-version
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[a-z-]+: (?<currentValue>\\S+)",
      ],
    },
    {
      // The github-actions manager skips expressions like `runs-on: ${{ arm64 && 'ubuntu-24.04-arm' || 'ubuntu-24.04' }}`
      "customType": "regex",
      // build-disk.yml is held on 24.04 (see the comment there), so only build.yml is tracked
      "managerFilePatterns": ["/^\\.github/workflows/build\\.yml$/"],
      "matchStrings": ["'ubuntu-(?<currentValue>\\d+\\.\\d+)(?:-arm)?'"],
      "depNameTemplate": "ubuntu",
      "datasourceTemplate": "github-runners",
    },
    {
      // bootc-image-builder is referenced as a plain string in the Justfile and build-disk.yml
      "customType": "regex",
      "managerFilePatterns": ["/^Justfile$/", "/^\\.github/workflows/build-disk\\.yml$/"],
      "matchStrings": ["(?<depName>ghcr\\.io/osbuild/bootc-image-builder):(?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "docker",
    },
  ],

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      // Base images are pinned per variant in the Containerfile; land new :stable digests once the PR build passes
      "automerge": true,
      "matchFileNames": ["Containerfile"],
      "matchDepNames": ["ghcr.io/ublue-os/ucore-hci", "ghcr.io/ublue-os/ucore-minimal"],
      "matchUpdateTypes": ["digest"],
    },
    {
      // Materia is pre-1.0 and minors can break config; only patch releases land unattended
      "automerge": true,
      "matchDepNames": ["stryan/materia"],
      "matchUpdateTypes": ["patch"],
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ]
}
